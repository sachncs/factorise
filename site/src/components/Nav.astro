---
const links = [
  { href: '#algorithms', label: 'Algorithms' },
  { href: '#features', label: 'Features' },
  { href: '#pipeline', label: 'Pipeline' },
  { href: '#install', label: 'Install' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
  data-nav
>
  <div class="container-page">
    <nav
      class="mt-4 flex items-center justify-between rounded-full border border-white/[0.06] bg-ink-950/70 px-5 py-2.5 backdrop-blur-xl transition-all duration-300"
      data-nav-inner
    >
      <a href="/" class="flex items-center gap-2.5 text-white">
        <span class="relative inline-flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-accent-400 to-accent-600 text-[13px] font-bold text-white shadow-glow">
          F
        </span>
        <span class="text-[15px] font-semibold tracking-tight">factorise</span>
      </a>

      <div class="hidden items-center gap-1 md:flex">
        {links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3.5 py-1.5 text-[13px] font-medium text-ink-300 transition-colors hover:bg-white/[0.06] hover:text-white"
          >
            {l.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-1.5 sm:gap-2">
        <button
          data-theme-toggle
          aria-label="Toggle theme"
          class="hidden h-8 w-8 items-center justify-center rounded-full border border-white/[0.06] bg-white/[0.03] text-ink-300 transition-colors hover:bg-white/[0.06] hover:text-white sm:inline-flex"
        >
          <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
          </svg>
          <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linejoin="round" />
          </svg>
        </button>

        <a
          href="https://github.com/sachncs/factorise"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="hidden h-8 w-8 items-center justify-center rounded-full bg-white/[0.04] text-white transition-colors hover:bg-white/[0.08] sm:inline-flex"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.4.98.01 1.97.14 2.89.4 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.05.78 2.11v3.13c0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        </a>

        <a
          href="#install"
          class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-[13px] font-medium text-ink-950 transition-all hover:bg-ink-100 hover:shadow-glow sm:px-3.5"
        >
          <span class="sm:inline">Install</span>
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector('[data-nav]');
  const inner = document.querySelector('[data-nav-inner]');
  if (nav && inner) {
    const onScroll = () => {
      if (window.scrollY > 12) {
        inner.classList.add('mt-3', 'bg-ink-950/85');
        inner.classList.remove('mt-4', 'bg-ink-950/70');
      } else {
        inner.classList.add('mt-4', 'bg-ink-950/70');
        inner.classList.remove('mt-3', 'bg-ink-950/85');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>