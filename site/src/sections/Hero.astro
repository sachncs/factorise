---
import HeroVisual from '~/components/HeroVisual';
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28 lg:pt-48 lg:pb-36">
  <!-- Background aurora glow -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 left-1/2 -z-10 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full bg-accent-500/40 blur-[100px] animate-aurora"></div>
    <div class="absolute top-32 left-[8%] -z-10 h-72 w-72 rounded-full bg-accent-400/30 blur-3xl"></div>
    <div class="absolute top-72 right-[6%] -z-10 h-96 w-96 rounded-full bg-indigo-500/25 blur-3xl"></div>
    <div class="absolute top-[40%] left-[20%] -z-10 h-64 w-64 rounded-full bg-violet-500/15 blur-3xl"></div>

    <!-- Subtle grid -->
    <div class="absolute inset-0 -z-10 bg-grid bg-grid-lg mask-fade-b opacity-[0.4]"></div>

    <!-- Vignette to keep edges deep -->
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,transparent_20%,#0a0a0c_75%)]"></div>
  </div>

  <div class="container-page relative">
    <div class="mx-auto max-w-4xl text-center">
      <div class="eyebrow mb-6 inline-flex">
        <span class="eyebrow-dot"></span>
        <span>Deterministic · Reproducible · Zero dependencies</span>
      </div>

      <h1 class="text-display-xl font-display text-balance font-semibold tracking-tightest">
        <span class="gradient-text">Factorisation</span>
        <br />
        that just
        <span class="accent-gradient-text italic">works.</span>
      </h1>

      <p class="mx-auto mt-7 max-w-2xl text-balance text-lg leading-relaxed text-ink-200 sm:text-xl">
        A single Python API for the entire factorisation stack —
        Miller-Rabin, Pollard's Rho, ECM, Quadratic Sieve, SIQS, GNFS —
        automatically composed into an adaptive pipeline.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#install" class="btn-primary group h-11 px-6 text-[14px]">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 3v12M6 9l6 6 6-6M5 21h14" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          pip install factorise
        </a>
        <a
          href="https://github.com/sachncs/factorise"
          target="_blank"
          rel="noopener"
          class="btn-ghost h-11 px-6 text-[14px]"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.4.98.01 1.97.14 2.89.4 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.05.78 2.11v3.13c0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
          View on GitHub
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 opacity-50 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <p class="mt-6 text-[13px] text-ink-500">
        Python 3.10+ · MIT licensed · Used in crypto, math-ed & CTF tooling
      </p>
    </div>

    <!-- Hero visual -->
    <div class="relative mx-auto mt-16 max-w-5xl sm:mt-20">
      <div class="absolute -inset-8 -z-10 rounded-[2.5rem] bg-gradient-to-b from-accent-500/20 via-accent-500/5 to-transparent blur-2xl"></div>
      <HeroVisual client:load />
    </div>
  </div>
</section>