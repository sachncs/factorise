---

<section class="relative overflow-hidden py-28 sm:py-36 lg:py-44">
  <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-1/2 h-[36rem] w-[80rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gradient-to-br from-accent-500/25 via-indigo-500/10 to-transparent blur-[120px]"></div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="text-display-lg font-semibold text-balance tracking-tightest sm:text-display-xl">
        Factorise anything.
        <br />
        <span class="gradient-text">Confidently.</span>
      </h2>
      <p class="mx-auto mt-7 max-w-xl text-balance text-lg leading-relaxed text-ink-200">
        Open-source, MIT-licensed, and built for the engineers who can't afford to be wrong.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#install"
          class="btn-primary h-12 px-7 text-[15px] ring-glow"
        >
          Get factorise
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a
          href="https://github.com/sachncs/factorise/blob/master/CONTRIBUTING.md"
          target="_blank"
          rel="noopener"
          class="btn-ghost h-12 px-7 text-[15px]"
        >
          Contribute
        </a>
      </div>
    </div>
  </div>
</section>