---
---

<section id="install" class="relative py-24 sm:py-32 lg:py-40">
  <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-1/2 h-[36rem] w-[80rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-500/[0.18] blur-[120px]"></div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <div class="eyebrow mb-5 inline-flex">
        <span class="eyebrow-dot"></span>
        <span>Get started in seconds</span>
      </div>
      <h2 class="text-display-lg font-semibold text-balance">
        One line of pip.
        <br />
        <span class="text-ink-400">A lifetime of correct answers.</span>
      </h2>
      <p class="mt-6 text-pretty text-lg text-ink-300">
        factorise runs on any modern Python. No compilers, no system libraries, no surprises.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-3xl border border-white/[0.08] bg-ink-950/70 shadow-card backdrop-blur-xl">
      <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-3">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]/70"></span>
        </div>
        <span class="font-mono text-[11px] text-ink-500">~ zsh</span>
        <span class="font-mono text-[11px] text-ink-600">python 3.10+</span>
      </div>

      <div class="divide-y divide-white/[0.04]">
        <div class="flex items-center gap-4 px-6 py-5">
          <span class="font-mono text-[12px] text-ink-500">$</span>
          <code class="flex-1 font-mono text-[14px] text-white sm:text-[15px]">pip install factorise</code>
          <button
            data-copy="pip install factorise"
            aria-label="Copy command"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/[0.06] bg-white/[0.03] text-ink-400 transition-colors hover:bg-white/[0.07] hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="flex items-center gap-4 px-6 py-5">
          <span class="font-mono text-[12px] text-ink-500">$</span>
          <code class="flex-1 font-mono text-[14px] text-white sm:text-[15px]">factorise 123456789 --verbose</code>
          <button
            data-copy="factorise 123456789 --verbose"
            aria-label="Copy command"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/[0.06] bg-white/[0.03] text-ink-400 transition-colors hover:bg-white/[0.07] hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="flex items-center gap-4 px-6 py-5">
          <span class="font-mono text-[12px] text-ink-500">$</span>
          <code class="flex-1 font-mono text-[14px] text-ink-300 sm:text-[15px]">python -c "from factorise import factorise; print(factorise(10**18+9).expression())"</code>
          <button
            data-copy='python -c "from factorise import factorise; print(factorise(10**18+9).expression())"'
            aria-label="Copy command"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-white/[0.06] bg-white/[0.03] text-ink-400 transition-colors hover:bg-white/[0.07] hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15V5a2 2 0 012-2h10" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="https://github.com/sachncs/factorise"
        target="_blank"
        rel="noopener"
        class="btn-ghost h-11 px-6 text-[14px]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.4.98.01 1.97.14 2.89.4 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.05.78 2.11v3.13c0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        Star on GitHub
      </a>
      <a
        href="https://pypi.org/project/factorise/"
        target="_blank"
        rel="noopener"
        class="btn-ghost h-11 px-6 text-[14px]"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 0L1 6v12l11 6 11-6V6L12 0zm0 2.18L20.5 7 12 11.82 3.5 7 12 2.18zM3 8.62l8 4.4v8.16l-8-4.36V8.62zm10 12.56V12.99l8-4.4v8.2l-8 4.39z"/></svg>
        View on PyPI
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = `<svg viewBox="0 0 24 24" class="h-4 w-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        setTimeout(() => (btn.innerHTML = original), 1400);
      } catch (_) {
        /* clipboard may be blocked; silent */
      }
    });
  });
</script>