---
const groups = [
  {
    title: 'Product',
    links: [
      { label: 'Algorithms', href: '#algorithms' },
      { label: 'Features', href: '#features' },
      { label: 'Pipeline', href: '#pipeline' },
      { label: 'Install', href: '#install' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: 'https://github.com/sachncs/factorise' },
      { label: 'PyPI', href: 'https://pypi.org/project/factorise/' },
      { label: 'Changelog', href: 'https://github.com/sachncs/factorise/blob/master/CHANGELOG.md' },
      { label: 'Roadmap', href: 'https://github.com/sachncs/factorise#roadmap' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Documentation', href: 'https://sachncs.github.io/factorise/' },
      { label: 'Contributing', href: 'https://github.com/sachncs/factorise/blob/master/CONTRIBUTING.md' },
      { label: 'Security', href: 'https://github.com/sachncs/factorise/blob/master/SECURITY.md' },
      { label: 'Issues', href: 'https://github.com/sachncs/factorise/issues' },
    ],
  },
  {
    title: 'Community',
    links: [
      { label: 'Code of Conduct', href: 'https://github.com/sachncs/factorise/blob/master/CODE_OF_CONDUCT.md' },
      { label: 'Support', href: 'https://github.com/sachncs/factorise/blob/master/SUPPORT.md' },
      { label: 'License (MIT)', href: 'https://github.com/sachncs/factorise/blob/master/LICENSE' },
    ],
  },
];
---

<footer class="relative border-t border-white/[0.06] pb-10 pt-20">
  <div class="container-page">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,minmax(0,1fr))]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-accent-400 to-accent-600 text-[13px] font-bold text-white shadow-glow">F</span>
          <span class="text-[15px] font-semibold tracking-tight text-white">factorise</span>
        </a>
        <p class="mt-4 max-w-xs text-[13px] leading-relaxed text-ink-400">
          Deterministic prime factorisation for Python.
          Zero dependencies. Pure stdlib. Adaptive by design.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <a
            href="https://github.com/sachncs/factorise"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/[0.06] bg-white/[0.03] text-ink-300 transition-colors hover:border-white/20 hover:bg-white/[0.07] hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.4.98.01 1.97.14 2.89.4 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.36-5.25 5.65.41.35.78 1.05.78 2.11v3.13c0 .3.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
          <a
            href="https://pypi.org/project/factorise/"
            target="_blank"
            rel="noopener"
            aria-label="PyPI"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/[0.06] bg-white/[0.03] text-ink-300 transition-colors hover:border-white/20 hover:bg-white/[0.07] hover:text-white"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M12 0L1 6v12l11 6 11-6V6L12 0zm0 2.18L20.5 7 12 11.82 3.5 7 12 2.18zM3 8.62l8 4.4v8.16l-8-4.36V8.62zm10 12.56V12.99l8-4.4v8.2l-8 4.39z"/></svg>
          </a>
        </div>
      </div>

      {groups.map((g) => (
        <div>
          <div class="text-[10px] font-semibold uppercase tracking-[0.2em] text-ink-500">{g.title}</div>
          <ul class="mt-5 space-y-3">
            {g.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-[13px] text-ink-300 transition-colors hover:text-white"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/[0.05] pt-8 sm:flex-row sm:items-center">
      <div class="text-[12px] text-ink-500">
        © 2026 Sachin · MIT licensed · Built for correctness.
      </div>
      <div class="flex items-center gap-4 text-[12px] text-ink-500">
        <a href="https://github.com/sachncs/factorise/blob/master/LICENSE" class="transition-colors hover:text-ink-300">License</a>
        <span class="h-3 w-px bg-white/10"></span>
        <a href="https://github.com/sachncs/factorise/blob/master/SECURITY.md" class="transition-colors hover:text-ink-300">Security</a>
        <span class="h-3 w-px bg-white/10"></span>
        <span class="font-mono">v0.7.0</span>
      </div>
    </div>
  </div>
</footer>