---
const features = [
  {
    title: 'Deterministic by design',
    body: 'Every result is reproducible. No random walks, no probabilistic answers — just correct factorisation every call.',
    icon: 'shield',
    span: 'lg:col-span-2',
  },
  {
    title: 'Zero dependencies',
    body: 'Pure Python and the standard library. Drop it into any environment without supply-chain risk.',
    icon: 'box',
  },
  {
    title: 'Adaptive engine',
    body: 'The hybrid router picks the right algorithm for every input size automatically.',
    icon: 'route',
  },
  {
    title: 'Strictly typed',
    body: 'PEP 484 hints across the public API. Plays nicely with mypy, pyright, and your IDE.',
    icon: 'type',
  },
  {
    title: 'Battle-tested',
    body: '97% coverage with Hypothesis property tests, regression sweeps, and CI-enforced benchmarks.',
    icon: 'check',
    span: 'lg:col-span-2',
  },
];

const iconPaths: Record<string, string> = {
  shield: 'M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z M9 12l2 2 4-4',
  box: 'M21 8l-9 4-9-4m18 0v8l-9 4-9-4V8m18 0l-9-4-9 4',
  route: 'M6 19V9a3 3 0 016 0v7M18 19V5a3 3 0 00-6 0v10M6 19a3 3 0 006 0M18 19a3 3 0 01-6 0',
  type: 'M4 7V5h16v2M9 19h6M12 5v14',
  check: 'M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section id="features" class="relative py-24 sm:py-32 lg:py-40">
  <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
    <div aria-hidden class="pointer-events-none absolute inset-x-0 top-1/3 -z-10 mx-auto h-96 max-w-4xl bg-accent-500/[0.08] blur-3xl"></div>
    <div class="absolute left-0 top-1/4 -z-10 h-80 w-80 rounded-full bg-accent-500/[0.08] blur-3xl"></div>
    <div class="absolute right-0 bottom-1/4 -z-10 h-72 w-72 rounded-full bg-indigo-500/[0.08] blur-3xl"></div>
  </div>

  <div class="container-page">
    <div class="mx-auto max-w-2xl">
      <div class="eyebrow mb-5 inline-flex">
        <span class="eyebrow-dot"></span>
        <span>Built for engineers</span>
      </div>
      <h2 class="text-display-lg font-semibold text-balance">
        Engineered with the same care
        <span class="text-ink-400"> as the algorithms it runs.</span>
      </h2>
    </div>

    <div class="mt-14 grid auto-rows-[minmax(0,1fr)] grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <div class={`group relative overflow-hidden rounded-3xl border border-white/[0.06] bg-white/[0.015] p-7 transition-all duration-500 hover:border-white/[0.12] hover:bg-white/[0.03] ${f.span ?? ''}`}>
          <div class="flex items-center gap-3">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/[0.08] bg-gradient-to-br from-white/[0.04] to-white/[0.01] text-accent-300">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d={iconPaths[f.icon]} stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3 class="text-base font-semibold tracking-tight text-white">{f.title}</h3>
          </div>
          <p class="mt-5 text-[15px] leading-relaxed text-ink-300">{f.body}</p>
          <div aria-hidden class="absolute inset-x-0 -bottom-px h-px bg-gradient-to-r from-transparent via-accent-400/0 to-transparent transition-all duration-700 group-hover:via-accent-400/50"></div>
        </div>
      ))}

      <!-- Callout card -->
      <div class="group relative col-span-1 overflow-hidden rounded-3xl border border-accent-500/30 bg-gradient-to-br from-accent-500/[0.08] to-transparent p-7 sm:col-span-2 lg:col-span-1">
        <div class="absolute -top-16 -right-16 h-40 w-40 rounded-full bg-accent-500/30 blur-3xl transition-opacity duration-500 group-hover:opacity-80"></div>
        <div class="text-[10px] font-medium uppercase tracking-[0.2em] text-accent-300">New</div>
        <h3 class="mt-3 text-base font-semibold tracking-tight text-white">Adaptive hybrid engine</h3>
        <p class="mt-3 text-[14px] leading-relaxed text-ink-300">
          A router inspects your input and dispatches to the optimal stage.
          Configure thresholds, or just let it pick.
        </p>
        <a href="https://github.com/sachncs/factorise#hybrid-engine" target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-medium text-accent-300 transition-colors hover:text-accent-200">
          Read the docs
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>