---
const metrics = [
  { value: '0', label: 'runtime deps', sub: 'stdlib only' },
  { value: '9', label: 'algorithms', sub: 'one API' },
  { value: '2⁶⁴', label: 'verified', sub: 'Miller-Rabin' },
  { value: '97%', label: 'test coverage', sub: 'hypothesis props' },
];
---

<section class="relative border-y border-white/[0.04] py-12 sm:py-16">
  <div class="container-page">
    <div class="mx-auto grid max-w-5xl grid-cols-2 gap-y-10 sm:grid-cols-4">
      {metrics.map((m, i) => (
        <div class="text-center sm:border-r sm:border-white/[0.06] sm:last:border-r-0">
          <div class="text-[10px] font-medium uppercase tracking-[0.2em] text-ink-500">0{i + 1}</div>
          <div class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{m.value}</div>
          <div class="mt-1 text-[13px] font-medium text-ink-300">{m.label}</div>
          <div class="mt-0.5 text-[12px] text-ink-500">{m.sub}</div>
        </div>
      ))}
    </div>
  </div>
</section>