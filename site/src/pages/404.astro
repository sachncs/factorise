---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/sections/Footer.astro';
---

<BaseLayout title="404 · factorise">
  <Nav />
  <main class="relative min-h-[60vh] flex items-center">
    <div aria-hidden class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-1/2 h-96 w-[60rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-500/15 blur-[120px]"></div>
    </div>
    <div class="container-page py-32 text-center">
      <div class="eyebrow mb-6 inline-flex justify-center">
        <span class="eyebrow-dot"></span>
        <span>404 · Not found</span>
      </div>
      <h1 class="text-display-lg font-semibold gradient-text">No such prime.</h1>
      <p class="mx-auto mt-5 max-w-md text-pretty text-ink-300">
        The page you're looking for doesn't exist (or hasn't been factored yet).
      </p>
      <a href="/" class="btn-primary mt-10 inline-flex h-11 px-6 text-[14px]">Back to home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>